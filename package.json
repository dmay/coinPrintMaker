{
  "name": "coinprint-maker",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test tests/import/*.test.mjs tests/geometry/*.test.mjs tests/export/*.test.mjs tests/build/*.test.mjs",
    "spike:svg": "node scripts/check-svg-extraction.mjs",
    "spike:stl": "node scripts/check-tiered-stl.mjs",
    "spike:3mf": "node scripts/check-layered-3mf.mjs",
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build:pages": "npm run typecheck && node scripts/build-pages.mjs",
    "check:pages": "npm run typecheck && node scripts/build-pages.mjs --check"
  },
  "dependencies": {
    "polygon-clipping": "0.15.7",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "jsdom": "26.1.0",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  },
  "engines": {
    "node": ">=24.0.0 <25"
  }
}
