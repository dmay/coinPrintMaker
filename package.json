{
  "name": "coinprint-maker",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "npm run test:unit && npm run test:legacy",
    "spike:svg": "node scripts/check-svg-extraction.mjs",
    "spike:stl": "node scripts/check-tiered-stl.mjs",
    "spike:3mf": "node scripts/check-layered-3mf.mjs",
    "dev": "vite",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.core.json && tsc -p tsconfig.tests.json",
    "build:pages": "npm run typecheck && node scripts/build-pages.mjs",
    "check:pages": "npm run typecheck && node scripts/build-pages.mjs --check",
    "test:unit": "vitest run",
    "test:legacy": "node --test tests/import/*.test.mjs tests/geometry/*.test.mjs tests/export/*.test.mjs tests/build/*.test.mjs",
    "test:real-coins": "vitest run tests/unit/real-coin-pipeline.test.ts"
  },
  "dependencies": {
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.2",
    "polygon-clipping": "0.15.7",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.186.1",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@react-three/test-renderer": "9.1.1",
    "@types/jsdom": "30.0.0",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "6.1.2",
    "jsdom": "26.1.0",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": ">=24.0.0 <25"
  }
}
